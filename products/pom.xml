<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0                       http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The Basics -->
    <groupId>com.mriss.mriss-parent</groupId>
    <artifactId>products</artifactId>
    <packaging>pom</packaging>
    <!-- <dependencies>...</dependencies> -->
    <parent>
        <groupId>com.mriss</groupId>
        <artifactId>mriss-parent</artifactId>
        <version>3.8.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <dependencyManagement>
        <dependencies>
            <!-- Override byte-buddy to 1.14.x: Mockito 4.8.x references ClassFileVersion.JAVA_V21
                 which was added in byte-buddy 1.14.0. Spring Boot 2.7.x bundles 1.12.x causing
                 NoSuchFieldError: JAVA_V21 on Java 17 at test runtime. Must appear BEFORE the BOM import. -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>
            <dependency>
                <!-- Import dependency management from Spring Boot -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.springfox</groupId>
                <artifactId>springfox-swagger2</artifactId>
                <version>${spring-fox.version}</version>
            </dependency>
            <dependency>
                <groupId>io.springfox</groupId>
                <artifactId>springfox-swagger-ui</artifactId>
                <version>${spring-fox.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger-annotations.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- FR006: jaxb-api centralised here so DSH modules need not declare a version -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>
            <!-- spring-boot-starter-data-solr removed in Spring Boot 2.6; managed here for DSH modules -->
            <dependency>
                <groupId>org.springframework.data</groupId>
                <artifactId>spring-data-solr</artifactId>
                <version>${spring-data-solr.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <!-- <modules> -->
    <!-- </modules> -->
    <properties>
        <!-- FR008: jenkins.view removed – CI/CD now uses GitHub Actions -->
        <!-- FR005: Spring Boot bumped to 2.7.18 (Java 17 compatible, last 2.x LTS release) -->
        <spring-boot.version>2.7.18</spring-boot.version>
        <spring-fox.version>3.0.0</spring-fox.version>
        <swagger-annotations.version>1.6.14</swagger-annotations.version>
        <jaxb-api.version>2.4.0-b180830.0359</jaxb-api.version>
        <!-- spring-boot-starter-data-solr removed in Spring Boot 2.6; use spring-data-solr directly -->
        <spring-data-solr.version>4.3.15</spring-data-solr.version>
        <!-- byte-buddy 1.12.x (bundled with Spring Boot 2.7.x) lacks ClassFileVersion.JAVA_V21,
             causing NoSuchFieldError when Mockito's inline mock maker runs on Java 17+.
             Override to 1.14.x which adds JAVA_V21 and is fully compatible. -->
        <byte-buddy.version>1.14.5</byte-buddy.version>
    </properties>


    <!-- Build Settings -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <mainClass>${start-class}</mainClass>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- FR005: override maven-release-plugin <arguments> at products level to include
             product-release-deployment in addition to deployment + release-deployment.
             Uses -D property flags (not -P) consistent with the new activation convention.
             This overrides the root parent-poms/pom.xml configuration which only uses
             deployment + release-deployment. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <arguments>-Ddeployment -Drelease-deployment -Dproduct-release-deployment -Dsite.deployment.personal.main=${site.deployment.personal.main}</arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!-- <reporting>...</reporting> -->

    <!-- More Project Information -->
    <name>Products</name>
    <description>Products Parent Project</description>
    <!-- <url>...</url> -->
    <!-- <inceptionYear>...</inceptionYear> -->
    <!-- <licenses>...</licenses> -->
    <!-- <organization>...</organization> -->
    <!-- <developers>...</developers> -->
    <!-- <contributors>...</contributors> -->

    <!-- Environment Settings -->
    <!-- <issueManagement>...</issueManagement> -->
    <!-- <ciManagement>...</ciManagement> -->
    <!-- <mailingLists>...</mailingLists> -->
    <scm>
        <connection>scm:git:${source.code.server}/${source.project}.git</connection>
        <developerConnection>scm:git:${source.code.server}/${source.project}.git</developerConnection>
        <url>${source.code.server}/${source.project}/tree/master</url>
        <tag>HEAD</tag>
    </scm>
    <!-- <prerequisites>...</prerequisites> -->
    <!-- Bintray (formerly hosting markdowndoc-maven-plugin) was shut down in 2021 — removed. -->
    <!-- <repositories>...</repositories> -->
    <!-- <pluginRepositories>...</pluginRepositories> -->
    <!-- <distributionManagement>...</distributionManagement> -->
    <profiles>
        <!-- FR001/FR008: 'deployment' profile removed from products level. The copy-readme-md and
             commit-readme-md executions it contained are identical to the root parent-poms/pom.xml
             'deployment' profile and are fully covered by inheritance. Removing here prevents
             duplicate execution IDs from being merged incorrectly across the hierarchy. -->
        <profile>
            <id>product-release-deployment</id>
            <!-- FR003: activated by -Dproduct-release-deployment property; starts here at products level -->
            <activation>
                <property>
                    <name>product-release-deployment</name>
                </property>
            </activation>
            <!-- doxia.skin.version and doxia.tools.version inherited from root parent-poms/pom.xml (2.0.0).
                 Removed local overrides (1.8) — versions must not be redefined in sub-modules. -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-changes-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-list-of-issues</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>github-text-list</goal>
                                </goals>
                                <configuration>
                                    <includeOpenIssues>false</includeOpenIssues>
                                    <onlyMilestoneIssues>true</onlyMilestoneIssues>
                                    <columnNames>Id,Type,Summary,Assignee,Reporter,Updated</columnNames>
                                    <failOnError>false</failOnError>
                                    <githubAPIServerId>github.com</githubAPIServerId>
                                    <personalToken>${github.personal.token}</personalToken>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <!-- Copy site sources into generated-site so maven-pdf-plugin
                                     can read them from the same siteDirectory path as DSH.
                                     inherited=false: DSH defines its own copy-site-resources-for-pdf
                                     execution at build level; this one is products-only. -->
                                <id>copy-site-resources-for-pdf</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/generated-site</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/site</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                                <inherited>false</inherited>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- maven-pdf-plugin:1.6.1 (Doxia 1.11.1 classpath) fails when it reads
                         target/generated-site/site.xml and finds maven-fluido-skin:2.0.0, which
                         declares a "2.0.0 Doxia Sitetools" prerequisite.
                         This antrun execution runs at compile phase (after process-resources copies
                         src/site/* with filtering, before prepare-package runs the pdf plugin) and
                         patches the skin version in the generated site.xml from 2.0.0 → 1.12.0,
                         which is the last fluido-skin release compatible with Doxia 1.11.1. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>fix-pdf-skin-version</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <!-- maven-pdf-plugin:1.6.1 requires Doxia Sitetools 1.x;
                                             maven-fluido-skin:2.0.0 requires Doxia Sitetools 2.0.0.
                                             Patch generated-site/site.xml to use fluido-skin:1.12.0
                                             which is compatible with Doxia 1.11.1, before pdf:pdf runs.
                                             Strategy: copy with replacestring tokenfilter → .pdf-bak,
                                             then move .pdf-bak → site.xml.  Both tasks use
                                             failonerror=false so modules without a generated-site/site.xml
                                             (e.g. dsh sub-modules) silently skip the entire step. -->
                                        <mkdir dir="${project.build.directory}/generated-site"/>
                                        <copy file="${project.build.directory}/generated-site/site.xml"
                                              tofile="${project.build.directory}/generated-site/site.xml.pdf-bak"
                                              failonerror="false">
                                            <filterchain>
                                                <tokenfilter>
                                                    <replacestring from="&lt;version&gt;2.0.0&lt;/version&gt;"
                                                                   to="&lt;version&gt;1.12.0&lt;/version&gt;"/>
                                                </tokenfilter>
                                            </filterchain>
                                        </copy>
                                        <move file="${project.build.directory}/generated-site/site.xml.pdf-bak"
                                              tofile="${project.build.directory}/generated-site/site.xml"
                                              overwrite="true"
                                              failonerror="false"/>
                                    </target>
                                </configuration>
                                <!-- No <inherited>false</inherited> here: the failonerror=false guards above
                                     make this a no-op wherever generated-site/site.xml does not exist
                                     (e.g. sub-modules that don't run the pdf plugin). -->
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Replaced markdowndoc-maven-plugin (abandoned, Bintray dead since 2021)
                         with standard maven-pdf-plugin from Maven Central. Version and Doxia
                         dependencies are managed in parent-poms/pom.xml pluginManagement. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pdf-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>pdf-generation</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>pdf</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/site/pdf</outputDirectory>
                                    <workingDirectory>${project.build.directory}/site/pdf</workingDirectory>
                                    <aggregate>false</aggregate>
                                    <includeReports>false</includeReports>
                                    <siteDirectory>${project.build.directory}/generated-site</siteDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-readme</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>attach-artifact</goal>
                                </goals>
                                <configuration>
                                    <artifacts>
                                        <artifact>
                                            <file>${basedir}/target/site/pdf/README.pdf</file>
                                            <type>pdf</type>
                                            <classifier>readme</classifier>
                                        </artifact>
                                    </artifacts>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- FR006: maven-scm-publish-plugin removed from product-release-deployment.
                         Artifact deployment to maven-repo must use distributionManagement (defined
                         in parent-poms/pom.xml), not scm-publish. The scm-publish plugin is only
                         valid for site publishing to gh-pages (root parent-poms/pom.xml deployment profile). -->
                </plugins>
            </build>
        </profile>
    </profiles>
</project>